generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Org {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  currency     String        @default("AED")
  createdAt    DateTime      @default(now())
  branches     Branch[]
  users        User[]
  staff        Staff[]
  services     Service[]
  products     Product[]
  customers    Customer[]
  appointments Appointment[]
  sales        Sale[]
}

model Branch {
  id           String        @id @default(cuid())
  orgId        String
  org          Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name         String        @default("Main branch")
  staff        Staff[]
  appointments Appointment[]
  sales        Sale[]

  @@index([orgId])
}

enum Role {
  OWNER
  MANAGER
  STAFF
}

model User {
  id           String   @id @default(cuid())
  orgId        String
  org          Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email        String   @unique
  name         String
  role         Role     @default(OWNER)
  passwordHash String
  createdAt    DateTime @default(now())

  @@index([orgId])
}

model Staff {
  id            String        @id @default(cuid())
  orgId         String
  org           Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  branchId      String
  branch        Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name          String
  title         String        @default("")
  phone         String        @default("")
  color         String        @default("#6d4aff")
  baseSalary    Int           @default(0)
  commissionPct Int           @default(15)
  active        Boolean       @default(true)
  appointments  Appointment[]
  saleItems     SaleItem[]

  @@index([orgId])
}

model Service {
  id           String        @id @default(cuid())
  orgId        String
  org          Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name         String
  nameAr       String        @default("")
  category     String        @default("General")
  durationMin  Int           @default(60)
  price        Int
  active       Boolean       @default(true)
  appointments Appointment[]

  @@index([orgId])
}

model Product {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name  String
  price Int
  stock Int    @default(0)

  @@index([orgId])
}

model Customer {
  id           String        @id @default(cuid())
  orgId        String
  org          Org           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name         String
  phone        String        @default("")
  email        String        @default("")
  tag          String        @default("")
  notes        String        @default("")
  createdAt    DateTime      @default(now())
  appointments Appointment[]
  sales        Sale[]

  @@index([orgId])
}

enum ApptStatus {
  BOOKED
  CONFIRMED
  COMPLETED
  CANCELLED
  NOSHOW
}

enum ApptSource {
  ADMIN
  ONLINE
}

model Appointment {
  id          String     @id @default(cuid())
  orgId       String
  org         Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  branchId    String
  branch      Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  staffId     String
  staff       Staff      @relation(fields: [staffId], references: [id], onDelete: Cascade)
  serviceId   String
  service     Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  customerId  String?
  customer    Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  date        String
  startMin    Int
  durationMin Int
  status      ApptStatus @default(BOOKED)
  source      ApptSource @default(ADMIN)
  notes       String     @default("")
  createdAt   DateTime   @default(now())

  @@index([orgId, date])
}

model Sale {
  id         String     @id @default(cuid())
  orgId      String
  org        Org        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  branchId   String
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  date       String
  at         DateTime   @default(now())
  method     String     @default("CARD")
  discount   Int        @default(0)
  total      Int
  items      SaleItem[]

  @@index([orgId, date])
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  kind      String
  name      String
  unitPrice Int
  qty       Int     @default(1)
  staffId   String?
  staff     Staff?  @relation(fields: [staffId], references: [id], onDelete: SetNull)
}

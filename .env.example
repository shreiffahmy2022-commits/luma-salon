DATABASE_URL="postgresql://salon:salon@localhost:5432/salon?schema=public"
AUTH_SECRET="change-me-to-a-long-random-string"

# AI booking assistant (public /book/<slug> page). Leave the key blank to keep
# the assistant switched off — the booking form still works without it.
ANTHROPIC_API_KEY=""
# Optional. Defaults to Claude Haiku (fast and low-cost — a good fit for the
# high-volume booking chat). Set to a more capable model if you prefer,
# e.g. "claude-opus-5".
ANTHROPIC_MODEL=""
